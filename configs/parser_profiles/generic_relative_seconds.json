{
  "name": "generic_relative_seconds",
  "description": "범용 예시 프로파일: '[   12.345678] 메시지' (기준 시각 없는 경과 초). 특정 장비의 형식이 아니다.",
  "line_regex": "^\\[\\s*(?P<ts>\\d+(?:\\.\\d+)?)\\]\\s+(?:(?P<component>[A-Za-z0-9_.\\-/]+):\\s+)?(?P<message>.*)$",
  "timestamp": {"kind": "relative", "unit": "s"},
  "continuation": true,
  "sniff_threshold": 0.6,
  "code_regex": "(?i)\\b(?:code|err(?:or)?)\\s*[=:]\\s*(?P<code>[A-Za-z0-9_\\-]+)",
  "event_rules": []
}
